.gradle/
.idea/
local.properties
**/build/
*.iml
*.apk
*.aab
*.jks
*.keystore

# Local knowledge databases are never committed.
*.db
*.db-shm
*.db-wal

# Native/runtime payloads are generated from pinned/verified inputs and are never committed.
native/.probe/
app/src/main/jniLibs/arm64-v8a/
app/src/main/assets/runtime/cacert.pem

# Web renderer dependencies are pinned and staged into the APK at build time.
web/.stage/
app/src/main/assets/vendor/
